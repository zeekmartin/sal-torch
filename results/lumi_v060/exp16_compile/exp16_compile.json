  "caveats": {
    "dynamo_reset": "torch._dynamo.reset() runs before every benchmark_compile call; without it the dynamo cache limit (8 variants) silently returns eager timings for later arms.",
    "weights": "latency depends on shapes and dtypes, not weight values, so which arm the checkpoint came from does not affect these numbers.",
    "compile_cost": "compile_s is reported separately and excluded from the per-call timings; it is paid once per process.",
    "slicing": "sliced arms remove a uniform head count per layer, the only shape slice_heads() can express. The accuracy of these particular head sets is not the subject here.",
    "reduce_overhead": "uses CUDA graphs, which may be unavailable on ROCm; a failed mode is recorded with its error."
  },

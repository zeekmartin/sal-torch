  "caveats": {
    "inference_only": "No training of any kind. Every row is one deterministic sliced architecture scored on the full validation split, so there are no draws and no spread within a seed.",
    "not_true_fp32": "The accuracy column runs under autocast bfloat16, the path 1a, exp24 and exp25 score under, so it is comparable with them rather than with an FP32 reference.",
    "drophead_has_no_own_set": "DropHead resamples its mask every step, so unlike SAL it has no trained-for set. Every set here is external to it, which is the point of the experiment and also means it is never scored on home ground.",
    "pinned_vs_self": "magnitude_pXX uses the ranking of the --magnitude-from checkpoint for all of them, so the comparison is at a fixed architecture. The _self rows use each checkpoint's own ranking, which is exp24's reading; self_set_overlap says how far the two diverge.",
    "int4_is_simulated": "INT4 is quantize_weights(model, 4), the simulated per-channel round-trip, not bitsandbytes NF4."
  },
  "wall_clock_s": 83.8
